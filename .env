# ZeroMQ port layout
# 9000 — SBOM backend / result processor (downstream)
# 9001 — secops-polling-migration (upstream caller)
# 9002 — OSI Scanner ZMQ worker (this service)
ZMQ_WORKER_PORT=9002
SBOM_PROCESSOR_PORT=9000

# ZeroMQ addresses
ZMQ_LISTEN_ADDRESS=tcp://0.0.0.0:9002
ZMQ_WORKER_ADDRESS=tcp://localhost:9002
SBOM_BACKEND_ADDRESS=tcp://localhost:9000
ZMQ_ACK_TIMEOUT_MS=10000
SBOM_FORWARD_TIMEOUT_MS=5000

# Azure Blob Storage (shared by all scanners)
AZURE_CONTAINER_NAME=scan_results
AZURE_STORAGE_CONNECTION_STRING=